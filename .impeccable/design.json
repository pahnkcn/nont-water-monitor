  "components": [
    {
      "name": "Header State Band",
      "kind": "nav",
      "refersTo": "header-band-normal",
      "description": "Sticky 56px band filled with the state colour; gilt wordmark left, state word with shape icon right.",
      "html": "<div class=\"ds-wrap\"><header class=\"ds-head\" data-status=\"normal\"><a class=\"ds-wordmark\" href=\"#\">ระดับน้ำท่าน้ำนนท์</a><p class=\"ds-state\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" aria-hidden=\"true\"><circle cx=\"10\" cy=\"10\" r=\"7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/><circle cx=\"10\" cy=\"10\" r=\"2.5\" fill=\"currentColor\"/></svg>ปกติ</p></header><header class=\"ds-head\" data-status=\"watch\"><a class=\"ds-wordmark\" href=\"#\">ระดับน้ำท่าน้ำนนท์</a><p class=\"ds-state\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" aria-hidden=\"true\"><path d=\"M10 2.5 18 17H2z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linejoin=\"round\"/><path d=\"M10 8v4.5\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/><circle cx=\"10\" cy=\"14.6\" r=\"1.1\" fill=\"currentColor\"/></svg>เฝ้าระวัง</p></header><header class=\"ds-head\" data-status=\"danger\"><a class=\"ds-wordmark\" href=\"#\">ระดับน้ำท่าน้ำนนท์</a><p class=\"ds-state\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" aria-hidden=\"true\"><path d=\"M6.9 2.5h6.2l4.4 4.4v6.2l-4.4 4.4H6.9l-4.4-4.4V6.9z\" fill=\"currentColor\"/><path d=\"M10 6v5\" stroke=\"#a3201a\" stroke-width=\"2\" stroke-linecap=\"round\"/><circle cx=\"10\" cy=\"13.6\" r=\"1.1\" fill=\"#a3201a\"/></svg>อันตราย</p></header></div>",
      "css": ".ds-wrap{display:grid;gap:8px}.ds-head{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:56px;padding:0 16px;background:var(--head-normal,#22302f);color:#fff;transition:background-color 400ms cubic-bezier(0.16,1,0.3,1);font-family:Anuphan,\"Noto Sans Thai\",sans-serif}.ds-head[data-status=\"watch\"]{background:var(--head-watch,#b65a2c)}.ds-head[data-status=\"danger\"]{background:var(--head-danger,#a3201a)}.ds-wordmark{font-family:Taviraj,serif;font-weight:600;font-size:1.1875rem;letter-spacing:.01em;color:var(--sign-normal,#c9a227);text-decoration:none}.ds-head[data-status=\"watch\"] .ds-wordmark,.ds-head[data-status=\"danger\"] .ds-wordmark{color:#fff}.ds-wordmark:focus-visible{outline:3px solid #fff;outline-offset:3px}.ds-state{display:inline-flex;align-items:center;gap:8px;margin:0;font-weight:700}"
    },
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Full-width 56px action filled with the action tokens; inset silt underline on hover.",
      "html": "<button class=\"ds-btn-primary\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" aria-hidden=\"true\"><path d=\"M10 3a4.5 4.5 0 0 0-4.5 4.5v2.8L4 13.5h12l-1.5-3.2V7.5A4.5 4.5 0 0 0 10 3Z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linejoin=\"round\"/><path d=\"M8.2 16a1.9 1.9 0 0 0 3.6 0\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\"/></svg>เปิดการแจ้งเตือน</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;width:100%;min-height:56px;padding:8px 24px;border:1.5px solid var(--action-line,#1e2b2a);border-radius:2px;background:var(--action-bg,#1e2b2a);color:var(--action-fg,#f1f2ee);font:600 1.0625rem Anuphan,\"Noto Sans Thai\",sans-serif;cursor:pointer;transition:background-color 150ms ease-out,color 150ms ease-out}.ds-btn-primary:hover{box-shadow:inset 0 -3px 0 var(--river,#7a6235)}.ds-btn-primary:active{transform:translateY(1px)}.ds-btn-primary:focus-visible{outline:3px solid var(--ink,#1e2b2a);outline-offset:3px}"
    },
    {
      "name": "Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Default button: 1.5px ink stroke, slat fill on hover.",
      "html": "<button class=\"ds-btn\">ส่งข้อความทดสอบ</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;padding:8px 24px;border:1.5px solid var(--ink,#1e2b2a);border-radius:2px;background:transparent;color:var(--ink,#1e2b2a);font:600 1rem Anuphan,\"Noto Sans Thai\",sans-serif;cursor:pointer;transition:background-color 150ms ease-out}.ds-btn:hover{background:var(--slat,#eceee9)}.ds-btn:active{transform:translateY(1px)}.ds-btn:focus-visible{outline:3px solid var(--ink,#1e2b2a);outline-offset:3px}.ds-btn[disabled]{opacity:.55;cursor:not-allowed}"
    },
    {
      "name": "Quiet Button",
      "kind": "button",
      "refersTo": "button-quiet",
      "description": "Strokeless underlined action for cancel/reset.",
      "html": "<button class=\"ds-btn-quiet\">ยกเลิก</button>",
      "css": ".ds-btn-quiet{min-height:48px;padding:8px;border:0;background:transparent;color:var(--ink,#1e2b2a);font:600 1rem Anuphan,\"Noto Sans Thai\",sans-serif;text-decoration:underline;text-underline-offset:.2em;text-decoration-thickness:1px;cursor:pointer}.ds-btn-quiet:hover{text-decoration-thickness:2px}.ds-btn-quiet:focus-visible{outline:3px solid var(--ink,#1e2b2a);outline-offset:3px}"
    },
    {
      "name": "Slats Segmented Control",
      "kind": "chip",
      "refersTo": "slats-option-selected",
      "description": "Range tabs as slats; the chosen slat closes dark.",
      "html": "<div class=\"ds-slats\" role=\"group\"><button aria-pressed=\"true\">24 ชม.</button><button aria-pressed=\"false\">7 วัน</button><button aria-pressed=\"false\">30 วัน</button></div>",
      "css": ".ds-slats{display:inline-flex;border:1.5px solid var(--ink,#1e2b2a);border-radius:2px}.ds-slats>*+*{border-left:1.5px solid var(--ink,#1e2b2a)}.ds-slats button{min-height:44px;min-width:64px;padding:0 12px;border:0;background:transparent;color:var(--ink,#1e2b2a);font:600 .9375rem Anuphan,\"Noto Sans Thai\",sans-serif;cursor:pointer}.ds-slats button:hover{background:var(--slat,#eceee9)}.ds-slats button[aria-pressed=\"true\"]{background:var(--action-bg,#1e2b2a);color:var(--action-fg,#f1f2ee)}.ds-slats button:focus-visible{outline:3px solid var(--river,#7a6235);outline-offset:-5px}"
    },
    {
      "name": "Choice Rows",
      "kind": "input",
      "refersTo": "choice-row-selected",
      "description": "Radio group as stacked slats; checked row fills with the action tokens.",
      "html": "<div class=\"ds-choices\"><label class=\"ds-choice\"><input type=\"radio\" name=\"f\" checked>ทุกเช้า</label><label class=\"ds-choice\"><input type=\"radio\" name=\"f\">ทุก 3 ชั่วโมง</label><label class=\"ds-choice\"><input type=\"radio\" name=\"f\">ปิด (เตือนเฉพาะเมื่อถึงเกณฑ์)</label></div>",
      "css": ".ds-choices{display:grid;border:1.5px solid var(--ink,#1e2b2a);border-radius:2px;font-family:Anuphan,\"Noto Sans Thai\",sans-serif;color:var(--ink,#1e2b2a)}.ds-choice{display:flex;align-items:center;gap:12px;min-height:48px;padding:8px 12px;cursor:pointer}.ds-choice+.ds-choice{border-top:1px solid var(--slat-edge,#c3c8c1)}.ds-choice:hover{background:var(--slat,#eceee9)}.ds-choice input{width:20px;height:20px;margin:0;accent-color:var(--ink,#1e2b2a)}.ds-choice:has(input:checked){background:var(--action-bg,#1e2b2a);color:var(--action-fg,#f1f2ee)}.ds-choice:has(input:checked) input{accent-color:var(--action-fg,#f1f2ee)}.ds-choice:has(input:focus-visible){outline:3px solid var(--river,#7a6235);outline-offset:-3px}"
    },
    {
      "name": "Select Field",
      "kind": "input",
      "refersTo": "select",
      "description": "Inline select: 44px, ground fill, 1.5px ink stroke.",
      "html": "<label class=\"ds-inline\">เวลา <select class=\"ds-select\"><option>07:00</option><option>18:00</option></select></label>",
      "css": ".ds-inline{display:flex;align-items:center;gap:12px;font-family:Anuphan,\"Noto Sans Thai\",sans-serif;color:var(--ink,#1e2b2a)}.ds-select{min-height:44px;padding:0 12px;border:1.5px solid var(--ink,#1e2b2a);border-radius:2px;background:var(--ground,#e4e6e1);color:inherit;font:inherit}.ds-select:focus-visible{outline:3px solid var(--ink,#1e2b2a);outline-offset:3px}"
    },
    {
      "name": "Dimension Gauge",
      "kind": "custom",
      "refersTo": "louvre",
      "description": "Signature: one ruler marked every 10 cm, a silt water column, plain 2px threshold rails, and a dimension line from the waterline to the next threshold carrying the numeral's centimetres.",
      "html": "<figure class=\"ds-gauge\"><svg viewBox=\"0 0 212 346\" role=\"img\" aria-label=\"ไม้วัดจำลอง อีก 103 ซม. ถึงระดับเฝ้าระวัง ขีดละ 10 ซม.\"><rect class=\"ds-g-col\" x=\"64.5\" y=\"12.5\" width=\"31\" height=\"321\"/><rect class=\"ds-g-water\" x=\"64\" y=\"268.2\" width=\"32\" height=\"65.8\"/><line class=\"ds-g-tick\" x1=\"96\" x2=\"106\" y1=\"12\" y2=\"12\"/><line class=\"ds-g-tick\" x1=\"96\" x2=\"101\" y1=\"26\" y2=\"26\"/><line class=\"ds-g-tick\" x1=\"96\" x2=\"101\" y1=\"40\" y2=\"40\"/><line class=\"ds-g-tick\" x1=\"96\" x2=\"101\" y1=\"54\" y2=\"54\"/><line class=\"ds-g-tick\" x1=\"96\" x2=\"101\" y1=\"68\" y2=\"68\"/><line class=\"ds-g-tick\" x1=\"96\" x2=\"106\" y1=\"82\" y2=\"82\"/><line class=\"ds-g-tick\" x1=\"96\" x2=\"101\" y1=\"96\" y2=\"96\"/><line class=\"ds-g-tick\" x1=\"96\" x2=\"101\" y1=\"110\" y2=\"110\"/><line class=\"ds-g-tick\" x1=\"96\" x2=\"101\" y1=\"124\" y2=\"124\"/><line class=\"ds-g-tick\" x1=\"96\" x2=\"101\" y1=\"138\" y2=\"138\"/><line class=\"ds-g-tick\" x1=\"96\" x2=\"106\" y1=\"152\" y2=\"152\"/><line class=\"ds-g-tick\" x1=\"96\" x2=\"101\" y1=\"166\" y2=\"166\"/><line class=\"ds-g-tick\" x1=\"96\" x2=\"101\" y1=\"180\" y2=\"180\"/><line class=\"ds-g-tick\" x1=\"96\" x2=\"101\" y1=\"194\" y2=\"194\"/><line class=\"ds-g-tick\" x1=\"96\" x2=\"101\" y1=\"208\" y2=\"208\"/><line class=\"ds-g-tick\" x1=\"96\" x2=\"106\" y1=\"222\" y2=\"222\"/><line class=\"ds-g-tick\" x1=\"96\" x2=\"101\" y1=\"236\" y2=\"236\"/><line class=\"ds-g-tick\" x1=\"96\" x2=\"101\" y1=\"250\" y2=\"250\"/><line class=\"ds-g-tick\" x1=\"96\" x2=\"101\" y1=\"264\" y2=\"264\"/><line class=\"ds-g-tick\" x1=\"96\" x2=\"101\" y1=\"278\" y2=\"278\"/><line class=\"ds-g-tick\" x1=\"96\" x2=\"106\" y1=\"292\" y2=\"292\"/><line class=\"ds-g-tick\" x1=\"96\" x2=\"101\" y1=\"306\" y2=\"306\"/><line class=\"ds-g-tick\" x1=\"96\" x2=\"101\" y1=\"320\" y2=\"320\"/><line class=\"ds-g-tick\" x1=\"96\" x2=\"101\" y1=\"334\" y2=\"334\"/><line class=\"ds-g-rule\" x1=\"96\" x2=\"96\" y1=\"12\" y2=\"334\"/><line x1=\"60\" x2=\"108\" y1=\"124.0\" y2=\"124.0\" stroke=\"var(--watch)\" stroke-width=\"2\"/><text class=\"ds-g-rail\" x=\"56\" y=\"128.5\" text-anchor=\"end\">เฝ้าระวัง*</text><line x1=\"60\" x2=\"108\" y1=\"82.0\" y2=\"82.0\" stroke=\"var(--danger)\" stroke-width=\"2\"/><text class=\"ds-g-rail\" x=\"56\" y=\"86.5\" text-anchor=\"end\">อันตราย*</text><g class=\"ds-g-reading\"><line class=\"ds-g-waterline\" x1=\"64\" x2=\"132\" y1=\"268.2\" y2=\"268.2\"/><circle class=\"ds-g-origin\" cx=\"132\" cy=\"268.2\" r=\"2.5\"/><line x1=\"108\" x2=\"137\" y1=\"124.0\" y2=\"124.0\" stroke=\"var(--watch)\" stroke-width=\"1\"/><line class=\"ds-g-dim\" x1=\"132\" x2=\"132\" y1=\"124.0\" y2=\"268.2\"/><path class=\"ds-g-end\" d=\"M128 128.0 l8 -8 M128 272.2 l8 -8\"/><text class=\"ds-g-value\" x=\"139\" y=\"203.1\">103<tspan class=\"ds-g-unit\"> ซม.</tspan></text></g></svg><figcaption>ขีดละ 10 ซม. · * เกณฑ์ชั่วคราว</figcaption></figure>",
      "css": ".ds-gauge{margin:0;width:212px;font-family:var(--font-ui),Anuphan,\"Noto Sans Thai\",sans-serif;color:var(--ink)}.ds-gauge svg{display:block;width:100%;height:auto;overflow:visible}.ds-gauge figcaption{margin-top:6px;font-size:0.8125rem;color:var(--ink-2)}.ds-g-col{fill:none;stroke:var(--ink-2);stroke-opacity:.35}.ds-g-water{fill:var(--river);transform-box:fill-box;transform-origin:bottom;animation:ds-g-rise 700ms cubic-bezier(0.16,1,0.3,1) both}.ds-g-rule{stroke:var(--ink);stroke-width:1.5}.ds-g-tick{stroke:var(--ink-2);stroke-width:1}.ds-g-rail{fill:var(--ink);font-size:13px;font-weight:700;paint-order:stroke;stroke:var(--ground);stroke-width:3px}.ds-g-waterline{stroke:var(--ink);stroke-width:2}.ds-g-origin{fill:var(--ink)}.ds-g-dim{stroke:var(--ink);stroke-width:1}.ds-g-end{fill:none;stroke:var(--ink);stroke-width:1.5}.ds-g-value{fill:var(--ink);font-size:20px;font-weight:700;font-variant-numeric:tabular-nums lining-nums}.ds-g-unit{font-size:13px;font-weight:600}.ds-g-reading{animation:ds-g-in 300ms ease-out 700ms both}@keyframes ds-g-rise{from{transform:scaleY(0)}to{transform:scaleY(1)}}@keyframes ds-g-in{from{opacity:0}to{opacity:1}}@media (prefers-reduced-motion:reduce){.ds-g-water,.ds-g-reading{animation:none}}"
    },
    {
      "name": "Alert Log Row",
      "kind": "custom",
      "refersTo": "alert-log",
      "description": "Hairline-ruled log; cleared alerts struck through, never deleted.",
      "html": "<ul class=\"ds-log\"><li data-cleared=\"true\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" aria-hidden=\"true\" style=\"color:#b65a2c\"><path d=\"M10 2.5 18 17H2z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linejoin=\"round\"/><path d=\"M10 8v4.5\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/><circle cx=\"10\" cy=\"14.6\" r=\"1.1\" fill=\"currentColor\"/></svg><span class=\"what\">เฝ้าระวัง 2.21 ม.</span><span class=\"when\">3 ต.ค. 21:40 น.</span><span class=\"by\">พ้นระดับเฝ้าระวัง 3 ต.ค. 23:10 น.</span></li></ul>",
      "css": ".ds-log{margin:0;padding:0;list-style:none;font-family:Anuphan,\"Noto Sans Thai\",sans-serif;color:var(--ink,#1e2b2a);font-variant-numeric:tabular-nums}.ds-log li{display:grid;grid-template-columns:auto 1fr;gap:4px 12px;padding:12px 0;border-bottom:1px solid var(--slat-edge,#c3c8c1)}.ds-log .when,.ds-log .by{grid-column:2;font-size:.875rem}.ds-log .when{color:var(--ink-2,#4a5755)}.ds-log .by{font-weight:600}.ds-log [data-cleared=\"true\"] .what{text-decoration:line-through;text-decoration-thickness:2px;text-decoration-color:var(--ink-2,#4a5755)}"
    }
  ],
  "narrative": {
    "northStar": "Old Hall Veranda",
    "overview": "You read the river level through the louvred awnings of the 1910 Nonthaburi provincial hall, which faces the water at the pier. The staff gauge itself is drawn like a dimension on the hall's survey drawing: one ruler marked every 10 cm, a silt column for the water, and a dimension line from the waterline to the next threshold that carries the same centimetres as the big numeral. The watch and danger thresholds cross it as brick-orange and red rails. Everything else on the surface comes from the same building: whitewashed ground, eave-shadow ink, Chao Phraya silt for water, the gilt of the signboard for the wordmark.\n\nThe system is flat and typographic. Hierarchy comes from scale: one very large tabular numeral, then plain Thai text at near-body sizes. Structure comes from 2px ink rules and hairline slat-edge rules, not from containers. The state of the river owns the whole header band. Night is a separate palette built for reading at 2 a.m., not an inversion of the day palette. It has its own deep-silt action colour, so no light slab ever appears in the dark.\n\nThe build has no cards, no drop shadows and no gradients. Status is never shown by colour alone.",
    "keyCharacteristics": [
      "A full-strength state colour fills the sticky header band. The wordmark sits left and the state word with its shape icon sits right.",
      "A giant tabular numeral is sized by its own column (container query).",
      "The dimension-line gauge is the signature instrument. It restates the numeral as a measured distance, so the drawing and the number can never disagree.",
      "Choices are built as slats: segmented tabs and stacked option rows where the chosen slat closes dark.",
      "Every corner is square (2px). Rules are 1px hairlines, 1.5px control strokes and 2px section rules.",
      "Light and night are two separate palettes. The night palette is applied by `[data-theme=\"dark\"]` or by `prefers-color-scheme` unless the user has chosen light."
    ],
    "rules": [
      {
        "name": "The State Owns the Band Rule",
        "body": "The sticky header is filled edge to edge with the current state colour: charcoal, then brick, then red. The background change takes 400ms ease-out-expo. The state word always carries its shape icon.",
        "section": "colors"
      },
      {
        "name": "The Gilt Is Signage Rule",
        "body": "Gilt appears only as the wordmark on the dark normal header, plus the night action outline and text. It is never used as an accent elsewhere.",
        "section": "colors"
      },
      {
        "name": "The No Light Slab at Night Rule",
        "body": "In night mode every selected or primary surface uses the night action tokens (deep silt fill, gilt text). Ink is never turned into a pale slab.",
        "section": "colors"
      },
      {
        "name": "The Shape Before Colour Rule",
        "body": "Status always has a shape: a ringed circle for normal, a triangle for watch and a solid octagon for danger. These are drawn on a 20px grid with 1.75 to 2 strokes. Rails carry a text label and value as well as their colour.",
        "section": "colors"
      },
      {
        "name": "The One Big Number Rule",
        "body": "Hierarchy comes from scale alone. The numeral is the only display-size text. Everything else stays between 0.8125rem and 1.75rem.",
        "section": "typography"
      },
      {
        "name": "The Tabular Figures Rule",
        "body": "Every number (levels, times, axes, tables) uses `tabular-nums lining-nums` (the `.num` class).",
        "section": "typography"
      },
      {
        "name": "The Flat Veranda Rule",
        "body": "No drop shadows, no gradients, no cards, and no depth anywhere, the gauge included.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do fill the whole header band with the current state colour and pair the state word with its circle, triangle or octagon icon.",
      "Do size the level numeral from its column with `clamp(4.5rem, 50cqi, 10rem)` and tabular lining figures.",
      "Do draw every threshold as a plain 2px rail in its state colour, labelled with its name, with an asterisk while it is provisional. Gauge and chart use the same rail.",
      "Do build choices as slats: a 1.5px ink frame, ink dividers, and the chosen slat filled with the action tokens.",
      "Do use the action tokens (not ink) for any selected or primary fill, so night mode stays deep silt with gilt.",
      "Do keep corners at 2px and separate sections with a 2px ink rule and white space."
    ],
    "donts": [
      "Don't use cards, drop shadows, gradients or depth anywhere.",
      "Don't compute the gauge's dimension separately from the numeral. Both come from `thresholdGap()`.",
      "Don't let colour carry status alone. Every state needs its shape or its word.",
      "Don't use gilt outside the wordmark and the night action, and don't set Taviraj anywhere but the wordmark.",
      "Don't delete alert-log entries. Strike them through when the water falls.",
      "Don't set body text in watch on the light ground (3.72:1). It is a graphic and border colour in light mode."
    ]
  }
}
